PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=AAA.aaa.123
DB_NAME=codeless
DB_SYNC=true
JWT_SECRET=change-me-in-production
# Admin bootstrap — used by `npm run seed:admin` to create the very first
# admin user so the /admin/models endpoints become reachable. Re-running
# the script is safe; existing admins are not modified.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- AI providers / real model calls ---
# Per-provider credentials live in the DATABASE (managed via /admin/providers),
# NOT here. These two vars are only a GLOBAL fallback for models/providers
# that have no stored apiKey/baseUrl. Leave them empty to keep credentials
# purely DB-driven; if nothing is configured the app uses the offline echo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- MinIO object storage (avatars and user files) ---
# REQUIRED for avatar upload; with these unset the upload endpoints answer 503.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=codeless
MINIO_REGION=us-east-1
# Base URL used when building the public avatarUrl returned by the API.
PUBLIC_BASE_URL=http://localhost:3000

# --- Live web search (Serper.dev) ---
# Required for the 🌐 web-search toggle; without it, search requests fail
# gracefully and answers continue without sources.
SERPER_API_KEY=
