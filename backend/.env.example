PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=codeless
DB_SYNC=true
JWT_SECRET=change-me-in-production
# Admin bootstrap — used by `npm run seed:admin` to create the very first
# admin user so the /admin/models endpoints become reachable. Re-running
# the script is safe; existing admins are not modified.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
